{
    "name": "confirm_order",
    "description": "Use this only after the customer clearly confirms the complete final order. Customer name, phone, and items are required. Include orderType as pickup or delivery if known, but do not ask pickup/delivery again if the customer already answered. If orderType is omitted, Freja backend will infer it. It saves the order in Freja and sends it to the restaurant dashboard and kitchen display.",
    "type": "webhook",
    "api_schema": {
        "url": "https://api.freja.plenware.cloud/elevenlabs/tools/confirm-order",
        "method": "POST",
        "request_body_schema": {
            "type": "object",
            "description": "Final order confirmation payload.",
            "required": [
                "order"
            ],
            "properties": {
                "order": {
                    "type": "object",
                    "description": "Complete final order. Include orderType if available, but do not ask the customer again just to fill it. For pickup, delivery_address should be empty. For delivery, include delivery_address.",
                    "required": [
                        "items",
                        "customerName",
                        "customerPhone"
                    ],
                    "properties": {
                        "items": {
                            "type": "array",
                            "description": "Confirmed order items with name, quantity, size, flavor for drinks, and modifiers.",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "description": "Menu item name."
                                    },
                                    "quantity": {
                                        "type": "number",
                                        "description": "Quantity."
                                    },
                                    "size": {
                                        "type": "string",
                                        "description": "Size if requested, for example standard, medium, family, familj, or large."
                                    },
                                    "modifiers": {
                                        "type": "object",
                                        "description": "Toppings, sauces, crust, removed ingredients, or other confirmed changes."
                                    },
                                    "flavor": {
                                        "type": "string",
                                        "description": "Drink flavor/name if applicable, for example Coca-Cola, Fanta, Sprite, or mineralvatten."
                                    }
                                }
                            }
                        },
                        "customer_name": {
                            "type": "string",
                            "description": "Customer name if collected."
                        },
                        "customer_phone": {
                            "type": "string",
                            "description": "Customer phone if collected."
                        },
                        "delivery_address": {
                            "type": "string",
                            "description": "Delivery address. Required only for delivery. Leave empty for pickup."
                        },
                        "language": {
                            "type": "string",
                            "description": "Conversation language if known."
                        },
                        "transcript": {
                            "type": "string",
                            "description": "Short final transcript or summary."
                        },
                        "orderType": {
                            "type": "string",
                            "enum": [
                                "pickup",
                                "delivery"
                            ],
                            "description": "Optional but preferred. Use pickup or delivery if already known. Do not ask again just to fill this field."
                        },
                        "clientOrderId": {
                            "type": "string",
                            "description": "Optional idempotency key for this voice call/order. Use the same value if confirm_order is retried."
                        },
                        "customerName": {
                            "type": "string",
                            "description": "Required. Customer name collected before final confirmation."
                        },
                        "customerPhone": {
                            "type": "string",
                            "description": "Required. Customer phone number collected before final confirmation."
                        }
                    }
                }
            }
        },
        "request_headers": {
            "Content-Type": "application/json"
        }
    },
    "response_timeout_secs": 30,
    "dynamic_variables": {
        "dynamic_variable_placeholders": {}
    },
    "assignments": [],
    "disable_interruptions": false,
    "force_pre_tool_speech": false
}
